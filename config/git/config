[alias]
	ci = "commit"
	co = "checkout"
	diverges = "!sh -c 'git rev-list --boundary $1...$2 | grep ^- | cut -c2-'"
	fpush = "push --force-with-lease"
	ignored = "ls-files --others -i --exclude-standard"
	ld = "log --pretty=format:\"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%an]\" --decorate --date=relative"
	lds = "log --pretty=format:\"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%an]\" --decorate --date=short"
	lgv = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative --numstat"
	ll = "log --pretty=format:\"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%an]\" --decorate --numstat"
	ls = "log --pretty=format:\"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%an]\" --decorate"
	r = "reset"
	r1 = "reset HEAD^"
	st = "status -sb"
	unadd = "reset HEAD"

[blame]
    ignoreRevsFile = :(optional).git-blame-ignore-revs

[branch]
	autosetuprebase = always

[color]
	ui = true

[core]
	quotepath = false

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true

[difftool]
	prompt = false

[fetch]
    prune = true
    pruneTags = true
    all = true

[init]
	defaultBranch = main

[mergetool]
	keepBackup = true
	prompt = false

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[rebase]
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[tag]
    sort = version:refname

[user]
	email = "kevinastone@gmail.com"
	name = "Kevin Stone"
